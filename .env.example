# Slack 勤怠記録ボット 環境変数設定例
# このファイルを .env にコピーして値を設定してください

# Slack Bot Token (xoxb-...)
# Slack App設定の "OAuth & Permissions" で取得
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App Token (xapp-...)
# Slack App設定の "Basic Information" > "App-Level Tokens" で取得
# connections:write スコープが必要
SLACK_APP_TOKEN=xapp-your-app-token

# Google Calendar API認証情報JSONファイルのパス
GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# 監視対象のチャンネルID（#勤怠管理チャンネル）
ATTENDANCE_CHANNEL_ID=C0AR1K8DXSP

# ボットのユーザーID
BOT_USER_ID=U0ARBAGUHBN
