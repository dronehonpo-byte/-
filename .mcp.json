{
  "mcpServers": {
    "openai-image": {
      "command": "${OPENAI_IMAGE_PYTHON:-python3}",
      "args": ["image-api/openai_image_mcp.py"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_IMAGE_MODEL": "${OPENAI_IMAGE_MODEL:-gpt-image-1}",
        "OPENAI_IMAGE_OUTPUT_DIR": "${OPENAI_IMAGE_OUTPUT_DIR:-generated-images}"
      }
    }
  }
}
