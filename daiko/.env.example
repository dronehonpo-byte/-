# 代行の窓口 — 環境変数サンプル（本番は実値を設定）

# 必須: 本番用シークレット（python -c 'import secrets; print(secrets.token_hex(32))'）
DAIKO_SECRET_KEY=change-me

# 公開URL（PWA / 絶対URL生成に使用）
APP_BASE_URL=https://daiko.example.com

# DB（未設定なら SQLite。本番は Render Postgres の接続文字列が入る）
# DATABASE_URL=postgresql://...

# ── 運営者情報（花田様名義）──
DAIKO_SERVICE_NAME=代行の窓口
DAIKO_AREA=栃木県宇都宮市
DAIKO_OPERATOR_NAME=花田 修
DAIKO_OPERATOR_PHONE=090-7343-8739
DAIKO_CONTACT_EMAIL=monjal@hotmail.com
DAIKO_ACCOUNT_EMAIL=monjal1@icloud.com

# ── 初期管理者（seed コマンドが作成）──
DAIKO_ADMIN_ID=admin
DAIKO_ADMIN_PASSWORD=

# ── SMS 認証 ──
# console: デモ（コードを画面/ログに表示） / twilio: 実送信（花田様名義の契約後）
SMS_BACKEND=console
# DAIKO_OTP_SHOW_IN_RESPONSE=false   # 本番は画面表示を必ず無効化
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+81...

# ── 地図・経路（既定は無料の OpenStreetMap 系。商用利用時は自社キー/タイルへ）──
# DAIKO_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# DAIKO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# DAIKO_OSRM_URL=https://router.project-osrm.org

# 地図の初期中心（宇都宮市役所付近）
DAIKO_DEFAULT_LAT=36.5551
DAIKO_DEFAULT_LNG=139.8828
