# === 必須 (本番) ==========================================
ECONTRACT_SECRET_KEY=change-me-with-secrets.token_hex(32)
APP_BASE_URL=https://econtract.example.com
ECONTRACT_COMPANY_NAME=株式会社サンプル

# === DB (Render Postgres を使う場合は自動で DATABASE_URL が入る) ===
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === Google OAuth (社内 Workspace のみログイン可) =========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=miyabee.jp        # 許可するドメイン

# === メール送信 ==========================================
EMAIL_BACKEND=sendgrid                 # sendgrid | smtp | console
ECONTRACT_DEFAULT_FROM=noreply@miyabee.jp
ECONTRACT_DEFAULT_FROM_NAME=Miyabee 電子契約

# SendGrid
SENDGRID_API_KEY=

# あるいは SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# === オプション ==========================================
ALLOW_PASSWORD_LOGIN=false             # OAuth 設定済なら false 推奨
DISABLE_REGISTRATION=true              # ブラウザからの新規登録を禁止
SESSION_COOKIE_SECURE=true             # https 配信なら true
GUNICORN_TIMEOUT=120
